# Copy to .env and fill in. fishmem reads these when no explicit config is given.

# LLM + embeddings (OpenAI). If unset, fishmem falls back to offline mock providers.
OPENAI_API_KEY=

# Required for the self-hosted dashboard. Generate distinct random values;
# never reuse provider keys or commit the filled .env file.
BETTER_AUTH_SECRET=
FISHMEM_SETUP_TOKEN=
CRON_SECRET=

# Required only when starting the optional Postgres/pgvector service.
POSTGRES_PASSWORD=

# Anthropic (only if you select the anthropic LLM provider).
ANTHROPIC_API_KEY=

# Postgres / pgvector (examples/postgres.ts).
DATABASE_URL=postgres://fishmem:replace-me@localhost:5432/fishmem

# Turso / libSQL (optional, for hosted SQLite).
# TURSO_DATABASE_URL=libsql://your-db.turso.io
# TURSO_AUTH_TOKEN=
