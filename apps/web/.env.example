# fishmem dashboard (apps/web) — copy to .env and fill in.
# OSS self-host runs on Node (libSQL/embedded SQLite by default). Cloudflare is
# an option (set via wrangler vars, not this file). See ../../DEPLOY.md.

# --- Runtime (self-host on Node with embedded SQLite — the default OSS path) ---
FISHMEM_RUNTIME=node
FISHMEM_DB=libsql
DATABASE_URL=file:.data/fishmem.db
# Raw file originals plus immutable extraction artifacts. Keep this directory
# on the same durable backup/retention boundary as DATABASE_URL.
FISHMEM_ASSET_DIR=.data/assets
# Pinned Docling service from apps/web/services/extractor/Dockerfile.
FISHMEM_EXTRACTOR_URL=http://127.0.0.1:5001
# Shared by the web cron route and the durable Node task poller.
CRON_SECRET=replace-with-a-separate-random-task-secret
# Used by scripts/poll-tasks.mjs when it runs outside Docker.
FISHMEM_TASK_WORKER_BASE_URL=http://127.0.0.1:3000
FISHMEM_TASK_POLL_MS=2000
FISHMEM_MAINTENANCE_MS=86400000

# --- URLs ---
NEXT_PUBLIC_SITE_URL=http://localhost:3000
NEXT_PUBLIC_PUBLIC_API_BASE_URL=http://localhost:3000
BETTER_AUTH_URL=http://localhost:3000

# --- Secret (generate: openssl rand -base64 32) ---
BETTER_AUTH_SECRET=replace-with-openssl-rand-base64-32
# Required in production before the first admin exists. Enter this value once
# in the setup form; it is never stored in the FishMem database.
FISHMEM_SETUP_TOKEN=replace-with-a-separate-random-token
# Your reverse proxy must overwrite this header; never pass through a
# user-supplied value. Cloudflare deployments default to cf-connecting-ip.
FISHMEM_TRUSTED_IP_HEADERS=x-forwarded-for

# --- LLM + embedding provider (used by the memory engine) ---
OPENAI_API_KEY=

# --- Login: email magic links ---
# On Node self-host with no email provider configured, the sign-in link is
# printed to the server console — copy it from the terminal to log in. Configure
# SMTP/Resend (or a Cloudflare email binding) for real delivery in production.
AUTH_EMAIL_FROM=memory@example.com
AUTH_EMAIL_FROM_NAME=FishMem

# --- Login: OAuth (optional) ---
# Google — Redirect URI: http://localhost:3000/api/auth/callback/google
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
# GitHub — Callback URL: http://localhost:3000/api/auth/callback/github
GITHUB_CLIENT_ID=
GITHUB_CLIENT_SECRET=

# --- Cloudflare (only if deploying the OSS app to Cloudflare directly) ---
# Bindings come from Wrangler; these are for drizzle-kit d1-http.
# CLOUDFLARE_ACCOUNT_ID=
# CLOUDFLARE_D1_DATABASE_ID=
# CLOUDFLARE_API_TOKEN=
