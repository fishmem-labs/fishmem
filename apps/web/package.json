{
	"name": "@fishmem/web",
	"version": "0.2.0",
	"private": true,
	"type": "module",
	"files": [
		"dist",
		"migrations",
		"scripts/migrate-libsql.mjs",
		"scripts/poll-tasks.mjs",
		"package.json"
	],
	"scripts": {
		"dev": "vite dev --port 3000",
		"dev:cloudflare": "cross-env FISHMEM_RUNTIME=cloudflare FISHMEM_DB=d1 vite dev --port 3000",
		"build": "vite build && node scripts/sanitize-build-output.mjs && tsc --noEmit",
		"build:cloudflare": "cross-env FISHMEM_RUNTIME=cloudflare FISHMEM_DB=d1 vite build && node scripts/sanitize-build-output.mjs && tsc --noEmit",
		"build:prod": "pnpm run build:cloudflare && wrangler deploy --dry-run --outdir=dist/worker",
		"start": "srvx serve --prod --dir . --static dist/client --entry dist/server/server.js",
		"test": "vitest run",
		"test:e2e": "playwright test",
		"e2e:prepare": "tsx e2e/prepare.ts",
		"e2e:serve": "pnpm e2e:prepare && pnpm build && vite preview --host 127.0.0.1 --port 3100",
		"deploy": "pnpm run build:cloudflare && wrangler deploy --keep-vars",
		"deploy:database": "wrangler d1 migrations apply fishmem --remote",
		"preview": "vite preview --host 0.0.0.0 --port 3000",
		"cf-typegen": "wrangler types --env-interface CloudflareEnv ./cloudflare-env.d.ts",
		"typecheck": "tsc --noEmit",
		"lint": "eslint .",
		"db:push": "drizzle-kit push --force",
		"db:migrate:libsql": "node scripts/migrate-libsql.mjs",
		"db:studio": "drizzle-kit studio"
	},
	"dependencies": {
		"@better-auth/drizzle-adapter": "1.6.27",
		"@cloudflare/containers": "0.3.7",
		"@fishmem/application": "workspace:*",
		"@fishmem/contracts": "workspace:*",
		"@fishmem/dashboard": "workspace:*",
		"@libsql/client": "^0.14.0",
		"@radix-ui/react-slot": "^1.2.4",
		"@tanstack/react-query": "^5.90.12",
		"@tanstack/react-router": "1.170.18",
		"@tanstack/react-start": "1.168.28",
		"better-auth": "1.6.27",
		"class-variance-authority": "^0.7.1",
		"clsx": "^2.1.1",
		"cross-env": "^10.1.0",
		"dotenv": "^17.4.2",
		"drizzle-orm": "^0.45.2",
		"fishmem": "workspace:*",
		"graphql": "^16.14.0",
		"highlight.js": "^11.11.1",
		"kysely": "0.28.17",
		"lucide-react": "^0.561.0",
		"openai": "^6.42.0",
		"react": "19.2.3",
		"react-dom": "19.2.3",
		"recharts": "^3.9.0",
		"sonner": "^2.0.7",
		"srvx": "0.12.5",
		"tailwind-merge": "^3.4.0",
		"tw-animate-css": "^1.4.0",
		"zod": "^4.2.1",
		"zustand": "^5.0.9"
	},
	"devDependencies": {
		"@cloudflare/vite-plugin": "1.20.0",
		"@cloudflare/workers-types": "5.20260812.1",
		"@playwright/test": "1.62.1",
		"@tailwindcss/postcss": "^4",
		"@tanstack/router-plugin": "1.168.20",
		"@types/node": "^26.5.0",
		"@types/react": "^19",
		"@types/react-dom": "^19",
		"@vitejs/plugin-react": "5.1.4",
		"drizzle-kit": "^0.31.10",
		"eslint": "^9",
		"tailwindcss": "^4",
		"typescript": "^5",
		"vite": "7.3.6",
		"vitest": "3.2.7",
		"wrangler": "4.121.0"
	},
	"packageManager": "pnpm@10.32.0",
	"exports": {
		"./package.json": "./package.json",
		"./*": "./*"
	}
}
