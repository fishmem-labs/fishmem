{
  "name": "@fishmem/web",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "vite dev --port 3000",
    "dev:cloudflare": "cross-env FISHMEM_RUNTIME=cloudflare FISHMEM_DB=d1 vite dev --port 3000",
    "build": "vite build && tsc --noEmit",
    "build:cloudflare": "cross-env FISHMEM_RUNTIME=cloudflare FISHMEM_DB=d1 vite build && tsc --noEmit",
    "build:prod": "pnpm run build:cloudflare && wrangler deploy --dry-run --outdir=dist/worker",
    "start": "vite preview --host 0.0.0.0 --port 3000",
    "test": "vitest run",
    "test:e2e": "playwright test",
    "e2e:prepare": "tsx e2e/prepare.ts",
    "e2e:serve": "pnpm e2e:prepare && pnpm build && vite preview --host 127.0.0.1 --port 3100",
    "deploy": "pnpm run build:cloudflare && wrangler deploy --keep-vars",
    "deploy:database": "wrangler d1 migrations apply fishmem --remote",
    "preview": "vite preview --host 0.0.0.0 --port 3000",
    "cf-typegen": "wrangler types --env-interface CloudflareEnv ./cloudflare-env.d.ts",
    "typecheck": "tsc --noEmit",
    "lint": "eslint .",
    "db:push": "drizzle-kit push --force",
    "db:studio": "drizzle-kit studio"
  },
  "dependencies": {
    "@better-auth/drizzle-adapter": "^1.6.12",
    "@cloudflare/containers": "0.3.7",
    "@fishmem/application": "workspace:*",
    "@fishmem/contracts": "workspace:*",
    "@fishmem/dashboard": "workspace:*",
    "@libsql/client": "^0.14.0",
    "@tanstack/react-router": "1.170.18",
    "@tanstack/react-start": "1.168.28",
    "@radix-ui/react-slot": "^1.2.4",
    "@tanstack/react-query": "^5.90.12",
    "better-auth": "^1.6.22",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "cross-env": "^10.1.0",
    "dotenv": "^17.4.2",
    "drizzle-orm": "^0.45.2",
    "fishmem": "workspace:*",
    "graphql": "^16.14.0",
    "highlight.js": "^11.11.1",
    "kysely": "0.28.8",
    "lucide-react": "^0.561.0",
    "openai": "^6.42.0",
    "react": "19.2.3",
    "react-dom": "19.2.3",
    "recharts": "^3.9.0",
    "sonner": "^2.0.7",
    "tailwind-merge": "^3.4.0",
    "tw-animate-css": "^1.4.0",
    "zod": "^4.2.1",
    "zustand": "^5.0.9"
  },
  "devDependencies": {
    "@cloudflare/workers-types": "^4.20260530.1",
    "@cloudflare/vite-plugin": "1.20.0",
    "@playwright/test": "1.54.2",
    "@tailwindcss/postcss": "^4",
    "@types/node": "^20.19.27",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "drizzle-kit": "^0.31.10",
    "eslint": "^9",
    "@tanstack/router-plugin": "1.168.20",
    "@vitejs/plugin-react": "5.1.4",
    "tailwindcss": "^4",
    "typescript": "^5",
    "vite": "7.3.6",
    "vitest": "2.1.9",
    "wrangler": "4.61.1"
  },
  "packageManager": "pnpm@9.15.0+sha512.76e2379760a4328ec4415815bcd6628dee727af3779aaa4c914e3944156c4299921a89f976381ee107d41f12cfa4b66681ca9c718f0668fa0831ed4c6d8ba56c",
  "exports": {
    "./package.json": "./package.json",
    "./*": "./*"
  }
}
